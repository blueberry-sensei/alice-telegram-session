# ─────────────────────────────────────────────────────────────────────────────
# Alice Telegram Session — cấu hình
# Chép thành `.env` rồi điền. KHÔNG commit `.env`.
# ─────────────────────────────────────────────────────────────────────────────

# ── Telegram ─────────────────────────────────────────────────────────────────
# Lấy từ @BotFather. BẮT BUỘC tắt privacy mode (/setprivacy -> Disable), nếu không
# bot sẽ không bao giờ thấy tin nhắn thường trong group.
TELEGRAM_BOT_TOKEN=

# Danh sách chat được phép, phân tách bằng dấu phẩy. BẮT BUỘC — để trống thì daemon
# TỪ CHỐI khởi động.
#
# Vì sao khắt khe tới vậy: bot này chạy agent CLI với quyền thật trên máy, và trong
# chat riêng thì tin nào nó cũng trả lời. Một danh sách trống mà vẫn chạy nghĩa là bất
# kỳ ai đoán ra username của bot đều có một shell trên máy bạn.
#
# Cách lấy id: bật ATLS_ALLOW_ALL_CHATS=1, chạy `atls run`, gõ /whoami trong phòng của
# mình, chép id vào đây, rồi tắt cờ đó đi.
ATLS_ALLOWED_CHATS=

# Nhận MỌI chat. Chỉ dùng lúc lấy chat id ở trên. Danh sách phía trên nếu có tên thì
# luôn THẮNG cờ này.
ATLS_ALLOW_ALL_CHATS=0

# ── Ingest ───────────────────────────────────────────────────────────────────
# webhook | polling
#   webhook — cần URL public HTTPS. Telegram đẩy tin tới, độ trễ thấp nhất.
#   polling — chạy được sau NAT, không cần domain. Dùng cho máy cá nhân.
ATLS_INGEST=polling

# Chỉ dùng khi ATLS_INGEST=webhook
ATLS_WEBHOOK_URL=
ATLS_WEBHOOK_HOST=0.0.0.0
ATLS_WEBHOOK_PORT=8443
# Telegram gửi lại header này ở mỗi request; khác giá trị dưới đây là request giả mạo.
ATLS_WEBHOOK_SECRET=

# ── Agent CLI ────────────────────────────────────────────────────────────────
# claude | codex | opencode | antigravity | custom
ATLS_AGENT=claude
ATLS_AGENT_MODEL=
# Thư mục làm việc của agent. Mặc định là thư mục chứa repo này.
ATLS_AGENT_CWD=

# Chạy agent ở chế độ không hỏi quyền (`claude --dangerously-skip-permissions`).
# Mặc định bật, vì cả sản phẩm dựa trên việc agent làm được việc thật. Đặt 0 nếu bạn
# không tin tưởng được hết những người có mặt trong ATLS_ALLOWED_CHATS.
ATLS_AGENT_SKIP_PERMISSIONS=1

# Chỉ dùng khi ATLS_AGENT=custom hoặc antigravity.
# Placeholder được thay lúc chạy: {prompt} {system} {session_id} {model} {cwd}
# Ví dụ: ATLS_AGENT_CMD=my-cli run --system {system} --sid {session_id} -- {prompt}
ATLS_AGENT_CMD=

# ── Session ──────────────────────────────────────────────────────────────────
# Ràng buộc cứng: một session không sống quá ngần này giây (mặc định 12 giờ).
ATLS_SESSION_MAX_AGE=43200
# Im lặng quá ngần này giây thì mở session mới cho sạch (mặc định 3 giờ).
ATLS_SESSION_IDLE=10800

# ── Trí nhớ hội thoại ────────────────────────────────────────────────────────
# Trần cửa sổ hội thoại đưa vào mỗi lượt.
ATLS_WINDOW_TOKENS=20000
# Vượt ngưỡng này thì nén phần cũ. Phải nhỏ hơn ATLS_WINDOW_TOKENS.
ATLS_COMPACT_TRIGGER=16000
# Số tin gần nhất LUÔN giữ nguyên văn, không bao giờ bị nén.
ATLS_KEEP_RAW=12

# ── Nhịp trả lời ─────────────────────────────────────────────────────────────
# Chờ ngần này giây im lặng rồi mới gọi agent (gom tin gõ liên tiếp).
ATLS_DEBOUNCE=10
ATLS_DEBOUNCE_MAX=120
# Chạy quá ngần này giây mà chưa xong thì gửi một câu trấn an.
ATLS_ACK_AFTER=12

# ── Đồng thời ────────────────────────────────────────────────────────────────
# Số chat được xử lý song song. Mỗi chat vẫn chỉ có tối đa 1 agent.
ATLS_WORKERS=3

# ── Nhân cách ────────────────────────────────────────────────────────────────
ATLS_PERSONA=alice
# Trigger word ngoài @mention, phân tách bằng dấu phẩy.
ATLS_TRIGGERS=alice ơi,alice à

# ── Cầu nối Alice Coding (tuỳ chọn) ──────────────────────────────────────────
# Bật thì mỗi lần compact sẽ ghi bản tóm tắt thành entry trong knowledge/context/
# để brain đánh chỉ mục. Cần repo có sẵn cấu trúc Alice Coding.
ATLS_BRAIN_BRIDGE=0
ATLS_KNOWLEDGE_DIR=

# ── Vận hành ─────────────────────────────────────────────────────────────────
ATLS_DATA_DIR=.atls
ATLS_LOG_LEVEL=INFO
